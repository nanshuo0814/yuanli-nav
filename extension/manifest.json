{
  "manifest_version": 3,
  "name": "源力导航助手",
  "version": "1.0.0",
  "description": "快速搜索源力导航、提交当前页收录建议",
  "action": {
    "default_title": "源力导航",
    "default_popup": "popup.html"
  },
  "permissions": ["activeTab", "contextMenus"],
  "host_permissions": ["https://github.com/*"],
  "background": {
    "service_worker": "background.js"
  }
}
